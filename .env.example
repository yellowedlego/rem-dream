# Google Gemini API Key (Required for live mode; leave empty when MODEL_MOCK=1)
GEMINI_API_KEY=

# Model identifier (Default: gemini-3.6-flash). 목록: https://ai.google.dev/gemini-api/docs/latest-model
GEMINI_MODEL=gemini-3.6-flash

# Mock mode flag: 1 = Offline deterministic mock, 0 or unset = Live Gemini Flash API
MODEL_MOCK=1
