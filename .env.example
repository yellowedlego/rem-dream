# Google Gemini API Key (Required for live mode; leave empty when MODEL_MOCK=1)
GEMINI_API_KEY=

# Model identifier (Default: gemini-3.6-flash). 목록: https://ai.google.dev/gemini-api/docs/latest-model
GEMINI_MODEL=gemini-3.6-flash

# Mock mode flag: 1 = Offline deterministic mock, 0 or unset = Live Gemini Flash API
MODEL_MOCK=1

# 내 AI 프롬프트 메일 보내기 (선택). 비워 두면 화면에서 메일 칸이 숨고 카드 인쇄·복사만 보인다.
# Gmail이면 2단계 인증을 켠 뒤 "앱 비밀번호"를 만들어 SMTP_PASS에 넣는다 (계정 비밀번호 아님).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# 1이면 실제로 보내지 않고 data/runtime/outbox/에 파일로만 남긴다 (연습·테스트용)
MAIL_MOCK=
